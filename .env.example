# ============================================================
# SAVDO ERP - GOOGLE SHEETS & GOOGLE SERVICE ACCOUNT SOZLAMALARI
# ============================================================

# 1. Google Sheets jadvalingizning ID raqami
# Jadval havolasi: https://docs.google.com/spreadsheets/d/BU_YERDA_SHEET_ID/edit
# O'sha havoladagi 'd/' va '/edit' orasidagi uzun kodni yozing:
GOOGLE_SHEET_ID=1a2b3c4d5e6f7g8h9i0j_SHEET_ID_HERE

# 2. Google Service Account elektron pochtasi (Google Cloud Console orqali yaratiladi)
# Masalan: my-sheets-bot@my-project-12345.iam.gserviceaccount.com
# MUHIM: Jadvalga (Google Sheet) shu pochtaga "Editor" (Tahrirlovchi) huquqini berishingiz kerak!
GOOGLE_SERVICE_ACCOUNT_EMAIL=my-sheets-bot@my-project-12345.iam.gserviceaccount.com

# 3. Google Service Account Private Key (Xususiy kalit)
# JSON faylidagi "private_key" qiymati.
# Qo'shtirnoq ichida, \n larni o'zgartirmasdan kiriting:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 4. Yoki to'liq Service Account JSON faylini bitta qatorda Base64 yoki JSON qilib kiriting (ixtiyoriy muqobil):
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# 5. API Xavfsizlik kaliti (Ixtiyoriy, agar backend API ni begona so'rovlardan himoyalamoqchi bo'lsangiz):
# API_SECRET_KEY=my_secure_erp_token_2026

# ============================================================
# FRONTEND SOZLAMALARI (Vite uchun)
# ============================================================
# Agar server alohida domenda bo'lsa (masalan: https://my-erp.vercel.app)
# Vercel da birgalikda deploy qilinsa bo'sh qoldirilsa avtomatik /api ga ulanadi
VITE_API_URL=
